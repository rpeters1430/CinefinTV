{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "* 8-11 * * *"
  ],
  "automergeSchedule": [
    "* 12-15 * * *"
  ],
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "enabledManagers": [
    "gradle",
    "github-actions"
  ],
  "assignees": [
    "rpeters1430"
  ],
  "assignAutomerge": true,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Enable pre-releases for AndroidX libraries",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^androidx\\./",
        "/^androidx\\..*/",
        "androidx.compose:compose-bom"
      ],
      "ignoreUnstable": false,
      "rangeStrategy": "bump",
      "versioning": "loose"
    },
    {
      "description": "Enable pre-releases for other Android development libraries",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "com.google.android.material:material",
        "/^com\\.google\\.accompanist\\./",
        "/^io\\.coil-kt\\./",
        "/^com\\.squareup\\.okhttp3\\./",
        "/^com\\.squareup\\.retrofit2\\./",
        "/^org\\.jetbrains\\.kotlinx\\./",
        "/^com\\.google\\.dagger\\./",
        "/^androidx\\.hilt\\./",
        "/^com\\.android\\.tools\\.build\\./",
        "com.android.tools.build:gradle"
      ],
      "ignoreUnstable": false,
      "rangeStrategy": "bump",
      "versioning": "loose"
    },
    {
      "description": "Keep Kotlin and KSP stable (they must match)",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin\\./",
        "/^com\\.google\\.devtools\\.ksp/"
      ],
      "ignoreUnstable": true,
      "rangeStrategy": "bump",
      "versioning": "gradle"
    },
    {
      "description": "Group and automerge stable minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "matchNewValue": "!/-/",
      "groupName": "Safe non-major dependency updates",
      "groupSlug": "safe-non-major-dependencies",
      "groupSingleUpdates": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group and automerge dependency pins",
      "matchUpdateTypes": [
        "pin"
      ],
      "groupName": "Safe non-major dependency updates",
      "groupSlug": "safe-non-major-dependencies",
      "groupSingleUpdates": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group and automerge GitHub Actions digest updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Safe non-major dependency updates",
      "groupSlug": "safe-non-major-dependencies",
      "groupSingleUpdates": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
